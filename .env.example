# Copy this file to .env and fill in what you need.

# Which LLM writes the decision explanations: ollama, openai, anthropic, or none (plain templates only)
LLM_BACKEND=ollama

# Ollama runs locally on your GPU (https://ollama.com). Pull the model first: ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Hosted APIs (only needed if you switch LLM_BACKEND). Check each provider's docs for current model names.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Paths
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports
